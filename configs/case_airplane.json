    "dim": "3d",
    "precision": "double",
    "description": "E10 飞机外流场算例（200 m/s，k-epsilon+SWF，重力 -9.81z）。mesh_file 请替换为你的网格（E10 DM/Meshing 生成导出）；首次真跑前按 references/prompt_calibration.md 校准 tui 应答序列并把 template.verified 改为 live。"
  },
  "fluent": {
    "mode": "real",
    "exe": "D:/Ansys-2023R1/ANSYS Inc/v222/fluent/ntbin/win64/fluent.exe",
    "parallel": 10,
    "timeout_s": 14400
  },
  "physics": {
    "model": "ke-standard",
    "gravity": [0.0, 0.0, -9.81]
